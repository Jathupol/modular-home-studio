# ---------------------------------------------------------------------------
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าของฐานข้อมูล/โฮสต์ของคุณเอง
# โปรเจกต์นี้อ่านค่าจาก env ทั้งหมด จึงย้ายไป Supabase self-host, Neon, RDS,
# Docker Postgres หรือผู้ให้บริการอื่นได้โดยไม่ต้องแก้โค้ด
# ---------------------------------------------------------------------------

# ใช้โดย scripts/db.sh (init / backup / restore) — connection string ของ Postgres
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:5432/postgres?sslmode=require"

# Frontend (ฝังตอน build ด้วย Vite — เป็นค่าสาธารณะได้)
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Backend / SSR (ห้ามเปิดเผย)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_PROJECT_ID="your-project-ref"
